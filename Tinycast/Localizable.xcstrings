    },
    "Its enclosing folder isn’t writable by you, and Tinycast never asks for an administrator password.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你对其所在文件夹没有写入权限，且 Tinycast 不会请求管理员密码。"
          }
        }
      }
    },
    "Its global shortcut and launcher references will also be removed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其全局快捷键和启动器引用也会被移除。"
          }
        }
      }
    },
