    "%@ (%@) will be moved to the Trash, where you can put them back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$@) will be moved to the Trash, where you can put them back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将把 %@（%@）移到废纸篓，你可以从中恢复。"
          }
        }
      }
    },
    "%@ (%@) will be moved to the Trash, where you can put them back. %@ will quit first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$@) will be moved to the Trash, where you can put them back. %3$@ will quit first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将把 %@（%@）移到废纸篓，你可以从中恢复。操作前会先退出 %@。"
          }
        }
      }
    },
